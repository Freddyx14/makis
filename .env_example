# ── Búsqueda ──────────────────────────────────────────────
# https://dashboard.exa.ai
EXA_API_KEY=

# ── Modelos ───────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Email (etapa 4) ───────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=
# Restringe los envíos a estas direcciones. Úsalo en pruebas.
EMAIL_ALLOWLIST=

# ── Publishers (etapa 4) ──────────────────────────────────
# mock | resend
PUBLISHER_EMAIL=resend
# mock | linkedin | x  — real requiere despliegue con HTTPS
PUBLISHER_SOCIAL=mock
# siempre mock en la demo
PUBLISHER_ADS=mock

# ── Rutas (12-factor) ─────────────────────────────────────
DATABASE_PATH=./data/app.db
MEDIA_PATH=./data/media

# ── Topes de coste ────────────────────────────────────────
MAX_EXA_SEARCHES=20
MAX_SCRAPED_PAGES=15

# ── Acceso ────────────────────────────────────────────────
# Clave para crear campañas nuevas
ADMIN_KEY=
