# ---------------------------------------------------------------------------
# Makis OS — variables de entorno
# Copia este archivo a `.env.local` (está en .gitignore) y rellena las claves.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Base de datos + Auth + Realtime. Realtime sustituye al SSE: el cockpit se
# suscribe a la tabla agent_steps y pinta el progreso en vivo.
# Claves en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO servidor. Se salta RLS. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión Postgres para migraciones automáticas en CI/CD (Supabase CLI)
# Obténla en: https://supabase.com/dashboard/project/_/settings/database
SUPABASE_DB_URL=

# Investigación con fuentes citadas. El equipo tiene créditos.
# https://dashboard.exa.ai
EXA_API_KEY=

# --- Modelos: OpenCode Zen --------------------------------------------------
# Gateway compatible con la API de OpenAI. UNA sola clave da acceso a modelos
# de OpenAI, Anthropic, Google, DeepSeek, Qwen y más.
# https://opencode.ai/auth
OPENCODE_API_KEY=

# Opcional: sobreescribe el modelo de cada tarea sin tocar código.
# Por defecto: extract=gpt-5-nano · synthesize=gpt-5.6-luna · reason=claude-sonnet-5
# MAKIS_MODEL_EXTRACT=
# MAKIS_MODEL_SYNTHESIZE=
# MAKIS_MODEL_REASON=

# --- Google Workspace -------------------------------------------------------
# Es el corazón del criterio 2 de la rúbrica: el agente vive donde ya trabajas.
#
# NO hace falta OAuth propio: se configura el proveedor Google DENTRO de
# Supabase Auth y este devuelve el `provider_token` con los scopes pedidos.
# Login y acceso a Drive son la MISMA pieza.
#
#   1. https://console.cloud.google.com/apis/credentials → crea OAuth Client
#   2. Pega client id y secret en Supabase → Authentication → Providers → Google
#   3. Marca los scopes de lib/supabase.ts (GOOGLE_SCOPES)
#
# Solo necesitas estas si llamas a las APIs de Google fuera del flujo de Supabase:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envío de email real (acto GOBERNAR) ------------------------------------
# Gmail NO sirve para campañas: ~500 envíos/día y quema la reputación del dominio.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Makis <onboarding@resend.dev>"

# --- Demo -------------------------------------------------------------------
# Si es `true`, el pipeline usa datos semilla deterministas en vez de llamar a
# las APIs. Red de seguridad para el escenario si falla la red. NO es el camino
# principal: la demo se presenta en modo real.
MAKIS_DEMO_FALLBACK=false

# --- Gemini Fallback --------------------------------------------------------
# Si OpenCode falla, se usa Google Gemini como fallback (gratis).
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
