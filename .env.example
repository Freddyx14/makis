# Copy to .env and replace with your real Exa API key.
EXA_API_KEY=your_exa_api_key_here

# Director: demo works without a model. Set compatible to use a real LLM.
LLM_PROVIDER=demo
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local by default. Production requires HTTPS, password, and a stable secret.
APP_ENV=development
DEMO_PASSWORD=
APP_SECRET=
CRAWL_MAX_PAGES=20
CRAWL_MAX_SECONDS=90
# DATABASE_PATH=data/makis.sqlite3
